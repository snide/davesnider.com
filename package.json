{
  "name": "ds",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev --port 5177",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src && pnpm run check",
    "format-check": "prettier --check .",
    "format-write": "prettier --write .",
    "lint:eslint": "eslint src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tsc": "svelte-kit sync && tsc --noEmit",
    "watchfiles": "tsx ./src/scripts/watch.ts",
    "uploadfiles": "tsx ./src/scripts/upload.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:headed": "playwright test --headed",
    "tunnel": "cloudflared tunnel run local-dev",
    "worker:github": "cd workers/activity-github && wrangler dev --var INGEST_URL:https://local.davesnider.com/api/activity/ingest/github",
    "worker:bluesky": "cd workers/activity-bluesky && wrangler dev --var INGEST_URL:https://local.davesnider.com/api/activity/ingest/bluesky",
    "worker:reddit": "cd workers/activity-reddit && wrangler dev --var INGEST_URL:https://local.davesnider.com/api/activity/ingest/reddit",
    "worker:hackernews": "cd workers/activity-hackernews && wrangler dev --var INGEST_URL:https://local.davesnider.com/api/activity/ingest/hackernews",
    "worker:bgg": "cd workers/activity-bgg && wrangler dev --var INGEST_URL:https://local.davesnider.com/api/activity/ingest/bgg",
    "worker:steam": "cd workers/activity-steam && wrangler dev --var INGEST_URL:https://local.davesnider.com/api/activity/ingest/steam"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/aleo": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@protomaps/basemaps": "^5.7.2",
    "@shikijs/transformers": "^4.5.0",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "isomorphic-dompurify": "^4.6.0",
    "layerchart": "^2.8.1",
    "maplibre-gl": "^6.15.0",
    "marked": "^18.1.1",
    "mdsvex": "^0.12.8",
    "mermaid": "^12.2.0",
    "mode-watcher": "^1.1.0",
    "pmtiles": "^4.5.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@google-cloud/storage": "^8.4.0",
    "@google-cloud/vision": "^6.2.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "mime": "^4.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@9.11.0+sha512.0a203ffaed5a3f63242cd064c8fb5892366c103e328079318f78062f24ea8c9d50bc6a47aa3567cabefd824d170e78fa2745ed1f16b132e16436146b7688f19b",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#db/*": "./src/db/*"
  }
}
